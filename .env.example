# Copy this file to .env and fill in real values. Never commit .env or share its values.

# --- MongoDB (docker-compose) ---
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# --- Backend (FastAPI) ---
# From the host use directConnection=true; inside docker-compose use host "mongodb:27017".
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB_NAME=myexpenses
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
RESEND_API_KEY=
EMAIL_FROM=

# --- Web (Next.js + Auth.js) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
