# Copy this file to .env and fill in real values. Never commit .env or share its values.

# --- MongoDB (docker-compose) ---
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# --- Backend (FastAPI) ---
# From the host use directConnection=true; inside docker-compose use host "mongodb:27017".
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB_NAME=myexpenses
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=myexpenses-api
JWT_AUDIENCE=myexpenses-clients
REFRESH_TOKEN_EXPIRE_DAYS=30
# HMAC key for one-time codes and email hashes (random, at least 32 bytes)
CODE_HASH_SECRET=
# Comma-separated Google OAuth client IDs accepted as ID token audience (web, android, ios)
GOOGLE_CLIENT_IDS=
RESEND_API_KEY=
EMAIL_FROM=
# resend | console (console writes to backend/.dev-outbox/emails.jsonl; rejected in production)
EMAIL_DELIVERY=resend
# development | test | production
ENVIRONMENT=development
MONGODB_TEST_DB_NAME=myexpenses_test

# --- Web (Next.js + Auth.js) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Backend URL used by the Next.js server (inside docker-compose: http://backend:8000/api/v1)
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# --- Telemetry: disabled (Principle VI, no data to third parties without opt-in) ---
NEXT_TELEMETRY_DISABLED=1
EXPO_NO_TELEMETRY=1

# --- Mobile (Expo) ---
# Android emulator: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Web origin used to build the invitation links shared from the app
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
# Reversed iOS client ID, e.g. com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=
